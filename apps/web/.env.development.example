# Web development environment variables
# Usage:
# 1) cp .env.development.example .env.development
# 2) Fill real values in .env.development
# VITE_ environment variables are exposed to the web client bundle.

# Dev Server URL
# Used by web auth and API clients.
VITE_SERVER_URL=http://localhost:3001

# Dev Frontend URL (for OAuth callbacks)
# Used as the public web app origin for auth callbacks, SEO, and sitemap generation.
VITE_APP_URL=http://localhost:3000

# Google Analytics (leave blank to disable)
# Measurement ID docs: https://support.google.com/analytics/answer/12270356
VITE_GA_MEASUREMENT_ID=

# OpenPanel Analytics
# Provider docs: https://openpanel.dev/docs/sdks/web
VITE_OPENPANEL_CLIENT_ID=

# Tawk.to live chat
# Copy both IDs from the embed snippet at https://dashboard.tawk.to
# Script URL shape: https://embed.tawk.to/{PROPERTY_ID}/{WIDGET_ID}
# Leave blank to disable the widget.
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# Cloudflare Turnstile site key for email sign-in (always-pass test key for local dev)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Public base URL of the template media bucket (previews and samples).
# Leave blank to use the placeholder posters in public/templates.
VITE_TEMPLATE_MEDIA_BASE_URL=
