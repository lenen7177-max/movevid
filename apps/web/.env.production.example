# Web production environment variables (optional)
# Usage: cp .env.production.example .env.production
#
# Public values (API and site URLs, media bucket, Turnstile site key, analytics and Tawk.to IDs)
# come from site.config.jsonc through apps/web/wrangler.jsonc (`pnpm site:sync`). Don't set
# them here: anything set here wins over site.config at build time, and `pnpm check:placeholders`
# fails while a VITE_* value here differs from it.

# IndexNow key (https://www.bing.com/indexnow/getstarted). Also read from the shell or CI.
INDEXNOW_KEY=
