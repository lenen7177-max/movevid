  "scripts": {
    "build": "node scripts/indexnow.mjs --key-file && vite build && node scripts/fix-sitemap.mjs",
    "serve": "vite preview",
    "dev": "vite dev --port=3000 --host",
    "start": "pnpm run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "wrangler:dev": "wrangler dev --port=3000",
    "deploy": "wrangler deploy && node scripts/indexnow.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "cf-typegen": "wrangler types",
    "blog:validate": "node ./scripts/validate-blog-content.mjs",
    "test": "node --test \"scripts/__tests__/*.test.mjs\"",
    "check-types": "fumadocs-mdx && tsc -b ../server && tsc --noEmit"
  },
