// Generated by `pnpm site:sync` from site.config.jsonc and apps/server/wrangler.template.jsonc.
// Do not edit: change those files and run `pnpm site:sync` again.
{
  "name": "your-project-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-15",
  "compatibility_flags": ["nodejs_compat"],
  // The API's custom domain, bound on deploy. Must be the host of SERVER_URL below.
  "routes": [{ "pattern": "api.example.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-project-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "WEBSITE_URL": "https://example.com",
    "SERVER_URL": "https://api.example.com",
    // Non-sensitive public IDs.
    // GitHub OAuth client ID
    "GITHUB_CLIENT_ID": "",
    // Google OAuth client ID
    "GOOGLE_CLIENT_ID": "",
    "APIMART_BASE_URL": "https://api.apimart.ai",
    // Optional: Seedance asset-library group that holds reviewed user photos.
    "APIMART_ASSET_GROUP_ID": "",
    // Public base URL of the template media bucket (reference clips and soundtracks), e.g. an R2
    // public bucket. Files follow the layout in apps/server/src/video/templates.ts.
    "TEMPLATE_MEDIA_BASE_URL": "https://media.example.com",
  },
  "r2_buckets": [
    {
      // Private bucket for uploaded photos and finished renders.
      "binding": "STORAGE",
      "bucket_name": "your-project-bucket",
    },
  ],
  // Email-sending auth routes (see src/middlewares/auth-email-guard.ts).
  // namespace_id must be unique within your Cloudflare account (see site.config.jsonc).
  "ratelimits": [
    {
      "name": "AUTH_EMAIL_IP_RATE_LIMITER",
      "namespace_id": "<YOUR_RATELIMIT_NAMESPACE_ID_1>",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "AUTH_EMAIL_ADDRESS_RATE_LIMITER",
      "namespace_id": "<YOUR_RATELIMIT_NAMESPACE_ID_2>",
      "simple": { "limit": 2, "period": 60 },
    },
  ],
  "triggers": {
    // Every 15 minutes: finish or refund abandoned renders. Daily: credit expiry and photo cleanup.
    "crons": ["*/15 * * * *", "10 16 * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
