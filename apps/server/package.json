{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:local": "pnpm run dev:init-d1 && drizzle-kit studio --config drizzle.local.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "pnpm run dev:init-d1 && drizzle-kit migrate --config drizzle.local.config.ts",
    "dev": "wrangler dev --port=3001 --var NODE_ENV:development",
    "dev:init-d1": "wrangler d1 execute DB --local --persist-to .wrangler/state --command 'select 1'",
    "start": "pnpm run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run && pnpm run test:node",
    "test:watch": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy",
    "secrets:bulk:production": "wrangler secret bulk .env.production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate-types": "wrangler types",
    "email-preview": "pnpm dlx react-email dev --dir src/emails/templates --port 4000",
    "test:node": "node --test --import tsx src/video/__tests__/*.test.ts src/payments/providers/creem/__tests__/*.test.ts src/sms/providers/__tests__/*.test.ts src/lib/__tests__/*.test.ts src/analytics/__tests__/*.test.ts",
    "dev:last-email": "node scripts/last-email.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@neondatabase/serverless": "^1.0.1",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@orpc/zod": "^1.14.8",
    "@react-email/components": "^1.0.2",
    "@react-email/render": "^2.0.1",
    "@repo/app-config": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/shared": "workspace:*",
    "@waffo/pancake-ts": "0.11.0",
    "better-auth": "catalog:",
    "better-auth-localization": "^3.0.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.7.3",
    "hono": "^4.11.7",
    "resend": "^6.6.0",
    "stripe": "^20.3.0",
    "ws": "^8.18.3",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.0",
    "@react-email/preview-server": "5.2.5",
    "@types/node": "^22.13.11",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.2",
    "tsdown": "^0.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
