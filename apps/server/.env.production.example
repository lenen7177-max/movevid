# Production secrets for the server worker, plus the local-only keys `pnpm db:migrate` reads.
# Usage:
# 1) cp .env.production.example .env.production
# 2) Fill real values in .env.production (leave unused providers empty)
# 3) pnpm run secrets:bulk:production -- --dry-run   # lists the key names it would upload
# 4) pnpm run secrets:bulk:production                # uploads them (scripts/secrets-bulk.mjs)
# Every key below is a worker secret except the "Local only" ones. Empty keys are never uploaded,
# so an empty value doesn't overwrite a secret already set on the worker; to delete one, run
# `npx wrangler secret delete <KEY>`.
# Public production URLs and OAuth client IDs belong in site.config.jsonc (written to wrangler.jsonc vars).

# Better Auth (worker secrets)
# Provider docs: https://better-auth.com/docs/installation
BETTER_AUTH_SECRET=
ADMIN_EMAIL=

# Cloudflare: Local only. drizzle.config.ts reads these for `pnpm db:migrate`; they are never
# uploaded to the worker (secrets:bulk:production skips them, as it does CLOUDFLARE_D1_DATABASE_ID).
# Provider console: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# `pnpm db:migrate` targets the D1 database from site.config.jsonc; no id needed here.

# Github OAuth (only when site.config.jsonc sets public.githubClientId, which turns it on)
# Provider console: https://github.com/settings/developers
GITHUB_CLIENT_SECRET=

# Google OAuth (only when site.config.jsonc sets public.googleClientId, which turns it on)
# Provider console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional; enable appleEnabled in packages/app-config/src/app-config.ts)
# Services ID / bundle id registered with Apple, e.g. com.example.web
APPLE_APP_BUNDLE_IDENTIFIER=

# Resend Email (worker secret; required while site.config.jsonc emailProvider is "resend")
# Provider console: https://resend.com/api-keys
RESEND_API_KEY=

# R2 Storage
# Public URL for accessing R2 stored files (e.g., https://pub-xxx.r2.dev or your custom domain)
R2_PUBLIC_URL=

# Alibaba Cloud Dypnsapi
# Provider docs: https://help.aliyun.com/zh/pnvs/developer-reference/api-dypnsapi-2017-05-25-sendsmsverifycode
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Aliyun OSS Storage - https://help.aliyun.com/zh/oss/
# Set common.storage.provider to "aliyun-oss" in packages/app-config/src/app-config.ts to use it.
# Reuses ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET above.
# Endpoint should not include the bucket name, e.g. oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=

# Stripe
# Provider docs: https://stripe.com/docs/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Creem
# Provider docs: https://docs.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Waffo Pancake - https://docs.waffo.ai/zh/integrate/skill
# Provider dashboard: https://pancake.waffo.ai/merchant/dashboard/integration
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=prod

# APIMart (Seedance video generation) - https://docs.apimart.ai
# Provider console: https://apimart.ai
APIMART_API_KEY=

# Cloudflare Turnstile secret for email auth routes
TURNSTILE_SECRET_KEY=
